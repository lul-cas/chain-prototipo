# Local development defaults. Copy to .env to override. Never use these values outside local development.
CHAIN_DB_USER=chain
CHAIN_DB_PASSWORD=chain
CHAIN_DB_NAME=chain
# Host port for PostgreSQL.
CHAIN_DB_PORT=5432
CHAIN_API_PORT=8080
CHAIN_FRONTEND_PORT=4200
# Origin of the frontend allowed to send state-changing API requests.
# Keep this origin on the same host and port as CHAIN_FRONTEND_PORT.
CHAIN_FRONTEND_ORIGIN=http://localhost:4200
# Key-encryption keys for automation secrets, "id:base64-of-32-bytes[,id:...]" (automation.md §4.1).
# Both the API and the automation service read them; only the API writes, with the active one.
# Unset, compose supplies a development-only key, which both services refuse outside development (automation.md §4.1).
# Never put a production key in .env.
#CHAIN_AUTOMATION_KEKS=
#CHAIN_AUTOMATION_ACTIVE_KEK=
# SHA-256 (lowercase hex) of the token Elixir presents when it reports automation results (automation-contract.md §4.1).
# Unset, compose uses the hash of a development-only token. Never put a production token or hash in .env.
#CHAIN_AUTOMATION_RESULT_TOKEN_SHA256=
# The token the automation service sends with results; its SHA-256 must be CHAIN_AUTOMATION_RESULT_TOKEN_SHA256.
# Unset, compose uses the development-only token that matches the development hash. Both services refuse the token and its
# hash outside development (automation.md §4.1). Never put a production token in .env.
#CHAIN_AUTOMATION_RESULT_TOKEN=
